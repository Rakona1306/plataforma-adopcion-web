#!/bin/sh
echo "======== VALIDACION ANTES DEL PUSH ========"

BRANCH=$(git rev-parse --abbrev-ref HEAD)
CHANGED=$(git diff --name-only origin/$BRANCH...HEAD 2>/dev/null || git diff --name-only HEAD~1)

if echo "$CHANGED" | grep -q '^frontend/'; then
  echo "-> Validando frontend..."
  pnpm --prefix frontend typecheck && pnpm --prefix frontend build || exit 1
fi

if echo "$CHANGED" | grep -q '^backend/'; then
  echo "-> Validando backend..."
  
fi

exit 0